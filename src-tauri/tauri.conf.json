{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A钱小工具",
  "version": "1.0.0",
  "identifier": "com.ylyin.aqian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A钱小工具",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ylyin",
    "copyright": "Copyright © 2026 ylyin",
    "shortDescription": "多人出行消费分摊工具",
    "longDescription": "一个完全离线的 Windows 桌面工具，用于记录出行活动和分摊金额。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
